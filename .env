# Base API URL - can include protocol (http:// or https://) and path segments
# Examples: bikmedia.com/dashboard/, https://api.example.com, http://localhost:8080
# The proxy will extract the origin (protocol + host) and use /dashboard as the path
VITE_BASE_API_URL=bikmedia.com/dashboard/
VITE_API_KEY=q25etr-as568-er9855-85rtg-45g56
VITE_AUTH_TOKEN=dZaMZ423sb0Nv6TtlbwoD2oKR7
VITE_APP_ENV=development

# API Configuration
# The service now always uses real API endpoints

# Encryption passphrase for client-side token obfuscation
# CryptoJS accepts any passphrase length (not limited to 32 characters)
# WARNING: Client-side encryption is obfuscation, not true security
# Change this passphrase in production and keep it secret
# Generate a secure passphrase: openssl rand -base64 32
# Note: CryptoJS uses passphrase-based encryption (PBKDF2 internally)
VITE_ENCRYPTION_KEY=bikmedia-dev-key-2025
