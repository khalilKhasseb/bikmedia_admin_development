# Production Environment Configuration
# This file serves as a template for production environment variables
# Actual values are injected via GitHub Actions secrets during deployment

# Base API URL - production endpoint
VITE_BASE_API_URL=bikmedia.com/dashboard/

# API credentials - values injected from GitHub Secrets
VITE_API_KEY=
VITE_AUTH_TOKEN=

# Application environment - set to production for deployment
VITE_APP_ENV=production

# Encryption key - value injected from GitHub Secrets
VITE_ENCRYPTION_KEY=

# Note: This file is used as a reference template.
# During GitHub Actions deployment, environment variables are set directly
# in the workflow using GitHub repository secrets for security.